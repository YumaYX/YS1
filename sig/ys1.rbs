module YS1
  VERSION: String

  # IP utilities.
  module IP
    PRIVATE_RANGES: Array[IPAddr]

    def self.netmask: (Integer prefix) -> String

    def self.include?: (String | Cidr range, String ip) -> bool

    def self.private?: (String ip) -> bool

    def self.version: (String ip) -> Integer

    # An IP address and its network prefix in CIDR notation.
    class Cidr
      def initialize: (String addr, Integer prefix) -> void

      def addr: () -> String

      def prefix: () -> Integer

      def to_s: () -> String
    end

    # Aggregates IPv4 addresses into CIDR blocks.
    module Aggregator
      def self.to_u32: (String ip) -> Integer

      def self.from_u32: (Integer number) -> String

      def self.aggregate: (Array[String] ip_list) -> Array[Cidr]

      def self.to_acl: (Array[Cidr] raw) -> Array[String]
    end
  end

  # Cartesian product utilities.
  module Join
    def self.cross: (*Array[untyped], ?limit: Integer?)
                  -> Enumerator[Array[untyped]]
                  | (*Array[untyped], ?limit: Integer?) { (Array[untyped]) -> void } -> void

    def self.cross_from_files: (*String, ?limit: Integer?)
                             -> Enumerator[Array[String]]
                             | (*String, ?limit: Integer?) { (Array[String]) -> void } -> void
  end

  # Utilities for fenced (``` style) code blocks.
  module CodeBlock
    BLOCK_PATTERN: Regexp

    def self.strip: (String str) -> String

    def self.blocks: (String text) -> Array[String]

    def self.languages: (String text) -> Array[String]

    def self.bodies: (String text) -> Array[String]

    def self.strip_all: (String text) -> String

    def self.language: (String block) -> String

    def self.body: (String? block) -> String?
  end

  # Reads a CSV file and converts it into structured formats.
  class CSV
    include Enumerable[Hash[String, untyped]]

    def self.write: (String file_path, Array[Hash[untyped, untyped] | Array[untyped]] rows, ?headers: Array[String]?) -> void

    attr_reader file_path: String
    attr_reader data: Array[Hash[String, untyped]]?

    def initialize: (String file_path) -> void

    def read: () -> Array[Hash[String, String]]

    def each: () -> Enumerator[Hash[String, String], self]
            | () { (Hash[String, String]) -> void } -> self

    def to_json: (*untyped) -> String

    def select_columns: (*String | Symbol names) -> Array[Hash[String, untyped]]

    def cast: (Hash[String | Symbol, ^(untyped) -> untyped] mapping) -> self

    def to_table: () -> String
  end

  # Dynamic attribute accessor backed by a Hash.
  module Accessor
    def data: () -> Hash[Symbol, untyped]

    def method_missing: (Symbol name, *untyped args) -> untyped

    def respond_to_missing?: (Symbol name, ?bool include_private) -> bool
  end

  # A parent object with its children.
  class ParentAndChild
    attr_reader parent: untyped
    attr_accessor children: Array[untyped]

    def initialize: (untyped parent) -> void

    def add_child: (*untyped child) -> void

    def family: () -> Array[untyped]

    def to_tree: (?indent: String) -> String
  end

  # File path utilities.
  module Path
    def self.file_list: (*untyped objs) -> Array[String]

    def self.read_lines: (*untyped objs, ?chomp: bool) -> Array[String]
  end

  # Aligned plain-text table rendering.
  module Table
    def self.format: (Array[untyped] rows, ?headers: Array[String]?) -> String
  end

  # Converts raw numeric values into human-readable strings.
  module Humanize
    BYTE_UNITS: Array[String]

    def self.bytes: (Numeric bytes) -> String

    def self.duration: (Numeric seconds) -> String

    def self.number: (Numeric number) -> String
  end

  # Marshal-based object serialization.
  module Report
    DEFAULT_FILE: String

    def self.save: (untyped object, ?String output_name) -> String

    def self.load: (?String input_name) -> untyped
  end

  # Namespace for interacting with the Ollama API.
  module Ollama
    DEFAULT_MODEL: String
    GENERATE_URL: String
    CHAT_URL: String

    def self.response: (String prompt, ?model: String, ?options: Hash[Symbol, untyped], **untyped) -> untyped

    def self.request: (String prompt, ?model: String, ?options: Hash[Symbol, untyped], **untyped) -> String

    def self.stream: (String prompt, ?model: String, ?options: Hash[Symbol, untyped], **untyped) { (String) -> void } -> String

    # Low-level request builder/executor.
    module Request
      def self.generate_body: (String prompt, model: String, ?options: Hash[Symbol, untyped], **untyped) -> Hash[String, untyped]

      def self.chat_body: (String prompt, model: String, ?options: Hash[Symbol, untyped], **untyped) -> Hash[String, untyped]

      def self.post: (untyped url, Hash[String, untyped] body) -> untyped

      def self.stream: (untyped url, Hash[String, untyped] body) { (String) -> void } -> String
    end

    # OCR helper.
    module OCR
      PROMPT: String
      DEFAULT_OPTIONS: Hash[Symbol, untyped]

      def self.encode_image: (String path) -> String

      def self.from_file: (String file_name, ?model: String, ?options: Hash[Symbol, untyped]) -> String
    end

    # Translation helper.
    module Trans
      DEFAULT_OPTIONS: Hash[Symbol, untyped]

      def self.prompt_template: (Symbol lang, String text) -> String

      def self.into: (Symbol lang, String text, ?model: String, ?options: Hash[Symbol, untyped]) { (String) -> void } -> String
    end

    # Structured JSON extraction helper.
    module Extract
      DEFAULT_OPTIONS: Hash[Symbol, untyped]

      def self.prompt_template: (String hint, String text) -> String

      def self.from_text: (String hint, String text, ?model: String, ?options: Hash[Symbol, untyped]) -> untyped
    end
  end
end

# Core extensions.

class Integer
  def ipv4mask: () -> String
end

class Hash[unchecked out K, unchecked out V]
  def to_anon_class: () -> Class
end

class String
  def to_pacs: (Regexp start_line) -> Array[YS1::ParentAndChild]
end
